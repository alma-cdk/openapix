    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "aws-cdk-lib": "2.190.0",
    "commit-and-tag-version": "^12",
    "constructs": "10.3.0",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^27.5.1",
    "jest-junit": "^16",
    "jsii": "~5.8.0",
    "jsii-diff": "^1.120.0",
    "jsii-docgen": "^10.5.0",
    "jsii-pacmak": "^1.120.0",
    "jsii-rosetta": "~5.8.0",
    "projen": "0.98.22",
    "ts-jest": "^27.1.5",
